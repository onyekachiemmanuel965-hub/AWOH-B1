DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
CURRENCY_DEFAULT="NGN"
PAYMENT_CURRENCY="NGN"

# Delivery (server-only — never NEXT_PUBLIC_*)
# These are PROVISIONAL development configuration knobs.
# DELIVERY_DEFAULT_DISTANCE_RATE (e.g. 500.00) is NOT confirmed production policy
# unless the business explicitly approves it. Final formula/rates remain TBD.
DELIVERY_DEFAULT_DISTANCE_RATE="500.00"
DELIVERY_MOCK_DISTANCE_KM=
DELIVERY_DISTANCE_PROVIDER="mock"
# DELIVERY_MAPS_API_KEY=

NODE_ENV=development

JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=1209600

COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# FORCE_HSTS=true  # enable only behind HTTPS / TLS-terminating proxy

# Rate limiting is in-process (MVP). Multi-instance production needs a shared
# store (Stage 10) — do not assume Redis is present in Stage 09.

# Payments
PAYSTACK_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_CALLBACK_URL=http://localhost:3000/account/orders
EMAIL_MODE=console
# RECEIPTS_DIR=
# UPLOADS_DIR=

# Optional Stage 08 staff smoke users (SEED_DEV_STAFF=true)
# DEV_SALES_EMAIL=
# DEV_SALES_PASSWORD=
# DEV_INVENTORY_EMAIL=
# DEV_INVENTORY_PASSWORD=
# DEV_CONTENT_EMAIL=
# DEV_CONTENT_PASSWORD=
# DEV_CUSTOMER_EMAIL=
# DEV_CUSTOMER_PASSWORD=
# SEED_DEV_ADMIN=false
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
